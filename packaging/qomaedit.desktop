[Desktop Entry]
Type=Application
Name=qOmaedit
GenericName=Text Editor
Comment=A lightweight script editor that follows the Omarchy theme
Exec=qomaedit %F
TryExec=qomaedit
Icon=qomaedit
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-shellscript;application/x-shellscript;text/x-python;text/x-lua;text/javascript;application/ecmascript;application/json;application/toml;application/yaml;
Keywords=text;editor;script;Omarchy;
StartupNotify=true

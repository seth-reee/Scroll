# Generated by build-package.sh with the source archive's SHA-256 digest.
pkgname=qomaedit
pkgver=@VERSION@
pkgrel=1
pkgdesc='Lightweight Qt text editor with live Omarchy theme support'
arch=('x86_64')
url='https://github.com/seth-reee/qOmaedit'
license=('MIT')
depends=('qt6-base>=6.5' 'gcc-libs' 'glibc')
optdepends=('qt6-wayland: native Wayland support')
makedepends=('cmake' 'ninja')
checkdepends=('desktop-file-utils')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
  desktop-file-validate "$srcdir/$pkgname-$pkgver/packaging/qomaedit.desktop"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
